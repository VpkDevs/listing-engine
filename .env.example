# =============================================================================
# FlipKit Pro — Environment Variables
# =============================================================================
# FlipKit Pro (artifacts/flipkit-pro) is a 100% client-side web application.
# NO environment variables, secrets, database, or backend server are required
# to build or deploy it to Vercel, Netlify, or Docker.
#
# BYOK Gemini AI ("Enhance with AI"):
#   There is NO server-side Gemini API key env var. Sellers optionally paste
#   their own free Google Gemini API key inside the app ("AI Settings" in the
#   sidebar). It is stored only in browser localStorage and sent only to Google.
# =============================================================================

# --- FlipKit Pro Web App (all optional; sane defaults are used when unset) ---

# Dev and preview server port for `pnpm dev` / `pnpm preview` (default: 5173)
PORT=5173

# Public base URL path if serving under a subpath, e.g. /flipkit/ (default: /)
BASE_PATH=/

# --- Optional API Server (artifacts/api-server — health check only) ----------
# Not called by FlipKit Pro and NOT needed for deployment. Only relevant if you
# run or extend `artifacts/api-server` later.

# Runtime environment: development | production (default: development)
NODE_ENV=production

# Bind address for api-server (default: 0.0.0.0)
HOST=0.0.0.0

# Structured logger verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Unused Database Scaffolding (lib/db) ------------------------------------
# Unused template scaffolding; only required if you later add Drizzle tables
# and import @workspace/db from artifacts/api-server.
# DATABASE_URL=postgresql://user:password@localhost:5432/flipkit
